# Address of the relay Worker (relay/worker.js) that serves OS Leisure map tiles.
# Leave blank to hide the OS layer. Not secret: the OS key stays in the Worker.
VITE_OS_TILES=https://sota-relay.alexjj.workers.dev

# Your SOTA database user id: summits in your activator log are marked on the home map.
# Leave blank to turn that off.
VITE_SOTA_USER_ID=94131
